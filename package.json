{
  "name": "astrisle",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:office": ".venv/Scripts/python.exe -m pytest workers/office/tests -q --basetemp=workers/office/.test-tmp",
    "format": "prettier --write apps packages scripts tests *.ts *.json",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "esbuild": "^0.27.0",
    "prettier": "3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
